name: Ejecución de Pruebas Unitarias

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  test:
    runs-on: windows-latest
    
    steps:
    - name: Checkout del código
      uses: actions/checkout@v3
      
    - name: Mostrar estructura de archivos
      run: |
        echo "Estructura del repositorio:"
        ls -R
        echo "Archivos .csproj encontrados:"
        find . -name "*.csproj"
        
    - name: Configurar .NET 6
      uses: actions/setup-dotnet@v3
      with:
        dotnet-version: '6.0.x'
        
    - name: Restaurar dependencias
      run: dotnet restore netcore/ExploringActions1/ExploringActions1.csproj
      
    - name: Compilar proyecto
      run: dotnet build netcore/ExploringActions1/ExploringActions1.csproj --no-restore
      
    - name: Ejecutar pruebas unitarias
      run: dotnet test netcore/TestExploringActions1/TestExploringActions1.csproj --no-build --verbosity normal
